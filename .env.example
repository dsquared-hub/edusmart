# Один .env на все сервисы (backend, bot, web). Скопируй в .env и заполни.
# Никогда не публикуй .env: в нём токены и пароли.

# --- Домен (только для боевого запуска: deploy/docker-compose.prod.yml) ---
DOMAIN=edu.example.uz

# --- Telegram ---
BOT_TOKEN=your_bot_token_from_botfather
# Имя бота без @ — для кнопки «Войти через Telegram» на сайте
BOT_USERNAME=your_bot_username
# Владелец бота (Telegram ID): /block, /unblock, /status, /reports и уведомления о жалобах.
# Узнать свой ID — команда /myid в боте.
OWNER_ID=
# Анти-флуд: не больше FLOOD_MAX_MESSAGES действий за FLOOD_WINDOW_SECONDS секунд
FLOOD_MAX_MESSAGES=6
FLOOD_WINDOW_SECONDS=3

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest
# 1 = демо-объяснения без Gemini (для проверки без ключа)
GEMINI_FAKE=0
# Второй независимый запрос проверяет правильные ответы (+ арифметика проверяется кодом).
# Отключать не рекомендуется: без проверки модель может научить ребёнка неправильному.
VERIFY_EXPLANATIONS=1

# --- База ---
POSTGRES_USER=edu
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=edu
# Для запуска без Docker. В docker-compose URL подставляется автоматически.
DATABASE_URL=postgresql://edu:change-me-postgres@localhost:5432/edu
# Резервные копии (deploy/backup.sh): сколько дней хранить
BACKUP_KEEP_DAYS=14

# --- Сайт и API ---
# Публичный адрес сайта. Для Mini App и кнопок «Открыть на сайте» нужен HTTPS.
WEB_URL=http://localhost:3000
# Длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
MAX_PHOTO_MB=5
# Ограничение запросов с одного IP в минуту (0 — выключено)
RATE_LIMIT_AUTH=10
RATE_LIMIT_EXPLAIN=20
RATE_LIMIT_API=180

# --- Правила ---
DAILY_EXPLAIN_LIMIT=20
# «Объясни проще» — платный запрос: не больше N на шаг и M в день
SIMPLIFY_PER_STEP=3
DAILY_SIMPLIFY_LIMIT=60
# Очки: с первой попытки / со второй; дальше — 0 (перебором очки не набрать)
POINTS_PER_STEP=10
POINTS_SECOND_TRY=5
TIMEZONE=Asia/Tashkent

# --- Персональные данные ---
# Пусто — страница /privacy на нашем сайте.
PRIVACY_POLICY_URL=
# Сменил текст политики — поменяй версию: родители подтвердят согласие заново.
POLICY_VERSION=2026-09-25
# 1 — демо-режим: ученик занимается сразу, без согласия родителя (не для продакшена)
DEMO_MODE=0
# Согласие родителя: пусто — нужно всегда, кроме демо-режима (DEMO_MODE=1 или GEMINI_FAKE=1);
# 1 — всегда; 0 — никогда
REQUIRE_PARENT_CONSENT=
OPERATOR_NAME="[Название организации — оператора персональных данных]"
OPERATOR_CONTACT="[e-mail и телефон для обращений]"
DATA_LOCATION="[Город, страна дата-центра]"

# ---- Academic Copilot: ИИ-проверка рукописных работ (Модуль 5.1) ----
# Папка для фото работ (по умолчанию backend/media; в Docker — том /app/media)
# MEDIA_DIR=
CHECK_MAX_FILES=40
CHECK_MAX_FILE_MB=10
# 1 — обработчик очереди внутри API; 0 — запускать отдельно: python -m app.workers
CHECK_WORKER=1
CHECK_CONCURRENCY=4
CHECK_TIMEOUT_SECONDS=60
CHECK_MAX_ATTEMPTS=3
# Пороги уверенности ИИ: >= ONE_CLICK — подтверждение в 1 клик; >= REVIEW — «Проверьте»; ниже — вручную
CHECK_ONE_CLICK_CONFIDENCE=90
CHECK_REVIEW_CONFIDENCE=70
# ---- Academic Copilot: уроки по учебнику, RAG (Модуль 5.2) ----
EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768
RAG_TOP_K=8
TEXTBOOK_MAX_MB=50
MATERIALS_TIMEOUT_SECONDS=45

# ---- Модуль 4: вечерний тест и Exam Readiness Score ----
# Пустой каталог программы — загрузить образец (официальную программу: scripts/load_curriculum.py)
CURRICULUM_AUTOLOAD=1
EVENING_START=17:00
EVENING_END=22:00
EVENING_REVIEW_DAYS=3,7,14
FREEZES_PER_WEEK=2
POINTS_CORRECTION=5
# ERS = M·w1 + S·w2 + V·w3 + R·w4 (сумма = 1)
ERS_WEIGHTS=0.50,0.25,0.15,0.10
ERS_MIN_ATTEMPTS=20
ERS_MASTERY_THRESHOLD=0.8
# ---- Модуль 4: вход по SMS и семейный аккаунт ----
# log — код пишется в лог сервера (разработка); eskiz — отправка через Eskiz.uz (нужен одобренный шаблон SMS)
SMS_PROVIDER=log
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
SMS_CODE_TTL=300
SMS_MAX_ATTEMPTS=5
SMS_RESEND_SECONDS=60
SMS_HOURLY_LIMIT=5
FAMILY_MAX_ADULTS=4
FAMILY_MAX_CHILDREN=6
FAMILY_INVITE_HOURS=24