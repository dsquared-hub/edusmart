# HTTPS-сертификат Let's Encrypt Caddy получает и продлевает сам.
# /api/* — сразу в FastAPI (настоящий IP клиента виден лимиту запросов),
# всё остальное — сайт на Next.js.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	@api path /api/*
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy web:3000
	}

	log {
		output stdout
		format console
	}
}
